 <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;" width="100%">
   <tr>
      <td align="left" valign="top">
            <table align="center" border="0" cellpadding="0" cellspacing="0" style="border-spacing:0;max-width:600px; padding-bottom: 20px;" width="100%">
               
               <!-- Image Section -->
               <tr>
                  <td valign="bottom" align="center" style="padding: 0 10px 20px;" width="50%">
                     <a alias="" conversion="false" data-linkto="https://" href="%%=RedirectTo(@ccbProductUrl0)=%%" style="text-decoration:none;" title="" target="_blank">   
                        <img alt="4colImage1" src="%%=v(@ccbImageUrl0)=%%" style="display: block; padding: 0px; height: auto; width: 100%; max-width: 216px; text-align: center; border: 0px;" width="216">
                     </a>
                  </td>
                  <td valign="bottom" align="center" style="padding: 0 10px 20px;" width="50%">
                     <a alias="" conversion="false" data-linkto="https://" href="%%=RedirectTo(@ccbProductUrl1)=%%" style="text-decoration:none;" target="_blank" title="">    
                        <img alt="4colImage2" src="%%=v(@ccbImageUrl1)=%%" style="display: block; padding: 0px; height: auto; width: 100%; max-width: 216px; text-align: center; border: 0px;" width="216">
                     </a>
                  </td>
               </tr>

               <!-- Title Section -->
               %%[ IF NOT EMPTY(@ccbProductTitle0) OR NOT EMPTY(@ccbProductTitle1) THEN ]%%
               <tr>
                  <td valign="top" align="center" style="padding: 0 20px;" width="50%">
                        <span style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; font-weight:bold; line-height: 120%;">%%=v(@ccbProductTitle0)=%%</span>
                  </td>
                  <td valign="top" align="center" style="padding: 0 20px;" width="50%">
                        <span style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; font-weight:bold; line-height: 120%;">%%=v(@ccbProductTitle1)=%%</span>
                  </td>
               </tr>
               %%[ ENDIF ]%%

               <!-- Copy Section -->
               %%[ IF NOT EMPTY(@ccbProductCopy0) OR NOT EMPTY(@ccbProductCopy0) THEN ]%%
               <tr>
                  <td valign="top" align="center" style="padding: 0 20px 20px;" width="50%">
                        <span style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; line-height: 120%;">%%=v(@ccbProductCopy0)=%%</span>
                  </td>
                  <td valign="top" align="center" style="padding: 0 20px 20px;" width="50%">
                        <span style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; line-height: 120%;">%%=v(@ccbProductCopy1)=%%</span>                             
                  </td>
               </tr>
               %%[ ENDIF ]%%

               <!-- CTA Section -->
               %%[ IF NOT EMPTY(@ccbProductCta0) OR NOT EMPTY(@ccbProductCta1) THEN ]%%
               <tr>
                  <td valign="top" align="center" style="padding: 0 20px;" width="50%">
                        <a alias="" conversion="false" data-linkto="https://" href="%%=RedirectTo(@ccbProductUrl0)=%%" style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; padding: 12px 12px 0; text-decoration: underline; line-height: 120%;" title="%%=v(@ccbProductCta0)=%%">
                           %%=v(@ccbProductCta0)=%%
                        </a>
                  </td>
                  <td valign="top" align="center" style="padding: 0 20px;" width="50%">
                        <a alias="" conversion="false" data-linkto="https://" href="%%=RedirectTo(@ccbProductUrl1)=%%" style="text-align: center; font-family: 'Arial', 'Source Sans 3', sans-serif; font-size: 16px; padding: 12px 12px 0; text-decoration: underline; line-height: 120%;" title="%%=v(@ccbProductCta1)=%%">
                           %%=v(@ccbProductCta1)=%%
                        </a>
                  </td>
               </tr>
               %%[ ENDIF ]%%

            </table>
      </td>
   </tr>
</table>