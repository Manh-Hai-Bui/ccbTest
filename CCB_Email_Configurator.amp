%%[ /* Email Content Configurator */]%%
%%[ 

SET @locale = AttributeValue('locale')
IF EMPTY(@locale) THEN
      SET @locale = 'de'
ENDIF

SET @ccbDemoSubjectField = field(row(BuildRowsetFromJSON(@JsonData,CONCAT('$.subject.value'),@locale),1), 1), 1)
SET @ccbDemoPreheader = field(row(BuildRowsetFromJSON(@JsonData,CONCAT('$.preheader.value.',@locale),1), 1), 1)
SET @ccbDemoTrackingId = field(row(BuildRowsetFromJSON(@JsonData,CONCAT('$.trackingId.value.',@locale),1), 1), 1)
]%%

<!--
<br>ccbDemoSubject: %%=v(@ccbDemoSubject)=%%
<br>ccbDemoPreheader: %%=v(@ccbDemoPreheader)=%%
<br>ccbDemoTrackingId: %%=v(@ccbDemoTrackingId)=%%
-->

%%[
SET @contentBlockRows = BuildRowsetFromJson(@JsonData,'$.contentBlocks.[*]',1)
SET @contentBlockRowCount = rowcount(@contentBlockRows)

IF @contentBlockRowCount > 0 then

    for @i = 1 to @contentBlockRowCount do

      SET @contentBlockRow = row(@contentBlockRows, @i)
      SET @isVisible = field(@contentBlockRow, "isVisible")
      SET @contentBlockKey = field(@contentBlockRow, "contentBlockKey")

      SET @contentRows = BuildRowsetFromJson(@JsonData,CONCAT('$.contentBlocks[', SUBTRACT(@i,1) ,'].content.[*]'),1)
      SET @contentRowsCount = rowcount(@contentRows)
      IF @contentRowsCount > 0 then

            FOR @j = 1 TO @contentRowsCount DO
                  SET @contentRow = row(@contentRows, @j)
                  SET @ampScriptVar = field(@contentRow, "ampScriptVar")
                  SET @content = field(row(BuildRowsetFromJSON(@JsonData,CONCAT('$.contentBlocks[', SUBTRACT(@i,1) ,'].content[',SUBTRACT(@j,1),'].value.',@locale),1), 1), 1)
                  ]%%
                        <!--
                        <br>ampScriptVar: %%=v(@ampScriptVar)=%%
                        <br>content: %%=v(@content)=%%
                        <br>SUBTRACT I: %%=SUBTRACT(@i,1)=%%
                        <br>SUBTRACT J: %%=SUBTRACT(@J,1)=%%
                        %%=TreatAsContent(Concat("%","%[SET @",@ampScriptVar," = '",@content,"']%","%"))=%%
                        -->
                  %%[
            NEXT @j

            
      ENDIF

      IF @isVisible == true THEN 
            ]%%
            <!--
            <br><br>row: %%=v(@i)=%%
            <br>isVisible: %%=v(@isVisible)=%%
            <br>contentBlockKey: %%=v(@contentBlockKey)=%%-->
            
            %%=ContentBlockByKey(@contentBlockKey)=%%
      
            %%[
      ENDIF

      

    NEXT @i

      /* Reset */
      SET @isVisible = ""
      SET @contentBlockKey = ""
      SET @ampScriptVar = ""
      SET @content = ""

ENDIF


]%%

<!--<br>JSON: %%=v(@JsonData)=%%-->
