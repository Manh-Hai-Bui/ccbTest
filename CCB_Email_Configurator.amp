%%[ /* Email Content Configurator */]%%
%%[ 

SET @locale = AttributeValue('locale')
IF EMPTY(@locale) THEN
      SET @locale = 'de'
ENDIF

SET @ccbDemoSubject = BuildRowsetFromJSON(@JsonData,CONCAT('$.subject.value.',@locale),1)
SET @ccbDemoPreheader = BuildRowsetFromJSON(@JsonData,CONCAT('$.preheader.value.',@locale),1)

SET @contentRows = BuildRowsetFromJson(@JsonData,'$.contentBlocks.[*]',1)
SET @rowCount = rowcount(@contentRows)

IF @rowCount > 0 then

    for @i = 1 to @rowCount do

      set @row = row(@lineItemRowset, @i)
      set @sku = field(@row, "sku")
      set @name = field(@row, "name")
      set @url = field(@row, "url")

      ]%%

      <br><br>row: %%=v(@i)=%%
      <br>sku: %%=v(@sku)=%%
      <br>name: %%=v(@name)=%%
      <br>url: %%=v(@url)=%%

      %%[

    NEXT @i

ENDIF


]%%

%%=v(@rowcount)=%%